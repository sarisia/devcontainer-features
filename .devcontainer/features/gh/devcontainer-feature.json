{
    "id": "gh",
    "version": "1.2.0",
    "name": "gh",
    "mounts": [
        {
            "source": "${localEnv:HOME}/.config/gh",
            "target": "/mnt/gh",
            "type": "bind"
        }
    ],
    "options": {
        "extensions": {
            "type": "string",
            "default": "github/gh-stack",
            "description": "Comma-separated list of gh extensions to install with `gh extension install`. Empty string installs none."
        }
    }
}

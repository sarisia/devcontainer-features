{
    "id": "glab",
    "version": "3.1.0",
    "name": "glab",
    "mounts": [
        {
            "source": "glab-config-${devcontainerId}",
            "target": "/mnt/glab-config",
            "type": "volume"
        }
    ],
    "containerEnv": {
        "GLAB_CONFIG_DIR": "/mnt/glab-config"
    },
    "postCreateCommand": {
        "fix-owner": "for d in /mnt/glab-config; do [ -O \"$d\" ] || sudo chown -R \"$(id -u):$(id -g)\" \"$d\"; done"
    }
}

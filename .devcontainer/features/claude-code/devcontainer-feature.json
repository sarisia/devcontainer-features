{
    "id": "claude-code",
    "version": "1.2.2",
    "name": "claude-code",
    "mounts": [
        {
            "source": "${localEnv:HOME}/.claude",
            "target": "/mnt/.claude",
            "type": "bind"
        },
        {
            "source": "${localEnv:HOME}/.claude.json",
            "target": "/mnt/.claude.json",
            "type": "bind"
        }
    ]
}

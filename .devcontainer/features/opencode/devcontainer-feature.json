{
    "id": "opencode",
    "version": "1.1.2",
    "name": "opencode",
    "mounts": [
        {
            "source": "${localEnv:HOME}/.claude",
            "target": "/mnt/.claude",
            "type": "bind"
        },
        {
            "source": "${localEnv:HOME}/.local/share/opencode",
            "target": "/mnt/opencode",
            "type": "bind"
        }
    ]
}

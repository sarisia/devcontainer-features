{
    "id": "opencode",
    "version": "1.2.0",
    "name": "opencode",
    "installsAfter": [
        "ghcr.io/devcontainers/features/node:2"
    ],
    "mounts": [
        {
            "source": "${localEnv:HOME}/.claude",
            "target": "/mnt/.claude",
            "type": "bind"
        },
        {
            "source": "${localEnv:HOME}/.local/share/opencode",
            "target": "/mnt/opencode",
            "type": "bind"
        }
    ]
}

{
    "id": "opencode",
    "version": "4.0.0",
    "name": "opencode",
    "installsAfter": [
        "ghcr.io/devcontainers/features/node:2"
    ],
    "mounts": [
        {
            "source": "opencode-data-${devcontainerId}",
            "target": "/mnt/opencode-data",
            "type": "volume"
        },
        {
            "source": "agents-${devcontainerId}",
            "target": "/mnt/agents",
            "type": "volume"
        }
    ],
    "postCreateCommand": {
        "fix-owner": "for d in /mnt/opencode-data /mnt/agents; do [ -O \"$d\" ] || sudo chown -R \"$(id -u):$(id -g)\" \"$d\"; done"
    }
}

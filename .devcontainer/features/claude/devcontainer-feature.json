{
    "id": "claude",
    "version": "3.2.0",
    "name": "claude",
    "legacyIds": ["claude-code"],
    "options": {
        "channel": {
            "type": "string",
            "enum": ["latest", "stable"],
            "default": "latest",
            "description": "Claude Code apt release channel"
        }
    },
    "mounts": [
        {
            "source": "claude-config-${devcontainerId}",
            "target": "/mnt/claude-config",
            "type": "volume"
        }
    ],
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/mnt/claude-config"
    },
    "postCreateCommand": {
        "fix-owner": "for d in /mnt/claude-config; do [ -O \"$d\" ] || sudo chown -R \"$(id -u):$(id -g)\" \"$d\"; done"
    }
}

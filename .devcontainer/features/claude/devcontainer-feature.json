{
    "id": "claude",
    "version": "1.3.0",
    "name": "claude",
    "options": {
        "channel": {
            "type": "string",
            "enum": ["latest", "stable"],
            "default": "latest",
            "description": "Claude Code apt release channel"
        }
    },
    "mounts": [
        {
            "source": "${localEnv:HOME}/.claude",
            "target": "/mnt/.claude",
            "type": "bind"
        },
        {
            "source": "${localEnv:HOME}/.claude.json",
            "target": "/mnt/.claude.json",
            "type": "bind"
        }
    ]
}

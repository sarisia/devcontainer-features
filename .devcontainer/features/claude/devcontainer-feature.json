{
    "id": "claude",
    "version": "2.1.0",
    "name": "claude",
    "legacyIds": ["claude-code"],
    "options": {
        "channel": {
            "type": "string",
            "enum": ["latest", "stable"],
            "default": "latest",
            "description": "Claude Code apt release channel"
        },
        "exclude": {
            "type": "string",
            "default": "",
            "description": "Comma-separated entry names to keep container-local instead of symlinking from the host: top-level entries of `~/.claude` (e.g. `settings.json,skills`), plus `.claude.json` for the host's `~/.claude.json`. Also suppresses container->host adoption for the listed entries."
        }
    },
    "mounts": [
        {
            "source": "${localEnv:HOME}/.claude",
            "target": "/mnt/.claude",
            "type": "bind"
        },
        {
            "source": "${localEnv:HOME}/.claude.json",
            "target": "/mnt/.claude.json",
            "type": "bind"
        }
    ],
    "postStartCommand": {
        "link-mounts": "/usr/local/share/claude-feature/links.sh"
    }
}

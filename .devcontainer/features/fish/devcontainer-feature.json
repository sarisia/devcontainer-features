{
    "id": "fish",
    "version": "2.0.0",
    "name": "fish",
    "legacyIds": ["fish-shell-history"],
    "mounts": [
        {
            "source": "fish-shell-history-${devcontainerId}",
            "target": "/mnt/fish-shell-history",
            "type": "volume"
        }
    ],
    "postCreateCommand": {
        "fix-owner": "for d in /mnt/fish-shell-history; do [ -O \"$d\" ] || sudo chown -R \"$(id -u):$(id -g)\" \"$d\"; done"
    }
}

{
    "id": "codex",
    "version": "4.0.0",
    "name": "codex",
    "description": "Installs Codex CLI and keeps ~/.codex and ~/.agents in Docker volumes so auth and sessions persist across rebuilds.",
    "installsAfter": [
        "ghcr.io/devcontainers/features/node:2"
    ],
    "mounts": [
        {
            "source": "codex-home-${devcontainerId}",
            "target": "/mnt/codex-home",
            "type": "volume"
        },
        {
            "source": "codex-auth",
            "target": "/mnt/codex-auth",
            "type": "volume"
        },
        {
            "source": "agents-${devcontainerId}",
            "target": "/mnt/agents",
            "type": "volume"
        }
    ],
    "containerEnv": {
        "CODEX_HOME": "/mnt/codex-home"
    },
    "postCreateCommand": {
        "fix-owner": "for d in /mnt/codex-home /mnt/codex-auth /mnt/agents; do [ -O \"$d\" ] || sudo chown -R \"$(id -u):$(id -g)\" \"$d\"; done"
    }
}

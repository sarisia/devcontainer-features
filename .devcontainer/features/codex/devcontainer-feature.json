{
    "id": "codex",
    "version": "2.0.0",
    "name": "codex",
    "description": "Installs Codex CLI and mounts ~/.codex and ~/.agents from the host so auth and sessions persist.",
    "installsAfter": [
        "ghcr.io/devcontainers/features/node:2"
    ],
    "mounts": [
        {
            "source": "${localEnv:HOME}/.codex",
            "target": "/mnt/.codex",
            "type": "bind"
        },
        {
            "source": "${localEnv:HOME}/.agents",
            "target": "/mnt/.agents",
            "type": "bind"
        }
    ]
}
